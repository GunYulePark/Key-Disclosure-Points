# TASK 01 template. Dedicated development DB exists; set approved local credentials.
# Private originals bucket exists. Configure Auth before enabling the client connection.
# Do NOT put backend keys in VITE_*, NEXT_PUBLIC_*, public/, docs/ or browser code.
APP_ENV=development
CENTRAL_STORE_MODE=disabled
SUPABASE_DEV_PROJECT_REF=
SUPABASE_DEV_URL=
SUPABASE_DEV_PUBLISHABLE_KEY=
# Authenticated reader JWT, short-lived. Configure separately on each PC.
SUPABASE_DEV_ACCESS_TOKEN=
# Server-side ingestion credentials: configure locally only after approval.
SUPABASE_DEV_SECRET_KEY=
SUPABASE_DEV_DATABASE_URL=
SUPABASE_DEV_STORAGE_BUCKET=kdp-dev-originals
SUPABASE_DEV_WORKSPACE_ID=
# Optional server-side login aliases. Use the confirmed Auth email for each company.
KDP_SIGNIN_CKD_ID=
KDP_SIGNIN_CKD_EMAIL=
KDP_SIGNIN_CKDHD_ID=
KDP_SIGNIN_CKDHD_EMAIL=
KDP_SIGNIN_KBP_ID=
KDP_SIGNIN_KBP_EMAIL=
# Separate credentials are required for evaluation/holdout (not shared here).
DART_API_KEY=
GEMINI_API_KEY=
